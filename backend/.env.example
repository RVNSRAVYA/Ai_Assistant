# ==========================================
# SmartCode AI - Environment Configuration
# ==========================================

# AI Provider Configuration
# Supported providers: openrouter, gemini, groq, openai, demo
AI_PROVIDER=openrouter

# Google Gemini API Key (Get a free key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Groq / OpenAI Compatible API Settings
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# OpenRouter (OpenAI-compatible; get a key at https://openrouter.ai/keys)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_MODEL=openrouter/auto
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Server Configuration
PORT=8000
HOST=0.0.0.0

# CORS Allowed Origins (comma-separated or * for all)
ALLOWED_ORIGINS=*
